                if draw.chams then pcall(function() draw.chams:Destroy() end) end
            end
            table.clear(vehicleDrawings)
            table.clear(vehicles)
        end
    end)

    createToggle("Submarine ESP", g, "submarineEsp", function(v)
        if not v then
            for _, draw in pairs(subDrawings) do 
