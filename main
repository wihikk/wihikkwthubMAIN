    while isScriptActive do
        task.wait(60)
        if settings.antiAfk then
            pcall(function()
                local vpSize = Camera.ViewportSize
                VirtualInputManager:SendMouseButtonEvent(vpSize.X/2, vpSize.Y/2, 0, true, game, 1)
