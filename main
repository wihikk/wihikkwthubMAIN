    CABetaLbl.ZIndex = 101

    local CACloseBtn = Instance.new("TextButton", CustomAimModal)
    CACloseBtn.Size = UDim2.new(0, 20, 0, 20)
    CACloseBtn.Position = UDim2.new(1, -25, 0, 5)
    CACloseBtn.BackgroundTransparency = 1
