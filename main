local lastStatsUpdate = tick()
local framesCount = 0
local lastFps = 0
local lastPing = -1

table.insert(scriptConnections, RunService.RenderStepped:Connect(function()
    framesCount = framesCount + 1
    local now = tick()
    if now - lastStatsUpdate >= 0.5 then
        local currentFps = math.floor(framesCount / (now - lastStatsUpdate))
        if currentFps ~= lastFps then
            FpsValue.Text = tostring(currentFps)
            lastFps = currentFps
            pcall(function()
                local t1 = TweenService:Create(FpsValue, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0.4})
                local t2 = TweenService:Create(FpsValue, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextTransparency = 0})
                t1:Play()
                t1.Completed:Connect(function() t2:Play() end)
            end)
        end
        
        local ping = 0
        pcall(function() ping = math.floor(LocalPlayer:GetNetworkPing() * 1000) end)
        if ping == 0 then pcall(function() ping = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()) end) end
        
        if ping ~= lastPing then
            PingValue.Text = tostring(ping)
            lastPing = ping
            pcall(function()
                local p1 = TweenService:Create(PingValue, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0.4})
                local p2 = TweenService:Create(PingValue, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextTransparency = 0})
                p1:Play()
                p1.Completed:Connect(function() p2:Play() end)
            end)
        end
        
        framesCount = 0
        lastStatsUpdate = now
    end
end))

