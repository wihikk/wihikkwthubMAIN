    if devToolsUnlocked then
        if DevPanel.Visible then return end
        DevPanel.Visible = true
        DevPanel.Size = UDim2.new(0, 0, 0, 0)
        TweenService:Create(DevPanel, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 200, 0, 130)}):Play()
