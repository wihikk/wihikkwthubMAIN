local function sendBindNotification(funcName, state)
    local notif = Instance.new("Frame", NotifContainer)
    notif.Size = UDim2.new(0.8, 0, 0, 32)
    notif.BackgroundColor3 = Theme.PanelBG
    notif.BackgroundTransparency = 0.1
    notif.Position = UDim2.new(0, 250, 0, 0)
    Instance.new("UICorner", notif).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", notif)
    stroke.Color = Theme.Border
    stroke.Thickness = 1
    
    local text = Instance.new("TextLabel", notif)
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = string.format("%s %s", funcName, state and "ON" or "OFF")
    text.TextColor3 = state and Color3.fromRGB(120, 255, 120) or Color3.fromRGB(255, 100, 100)
    text.Font = Enum.Font.GothamBold
    text.TextSize = 13
    
    local twIn = TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, 0, 0, 32)})
    table.insert(activeTweens, twIn)
    twIn:Play()
    
    task.delay(1.5, function()
        if not isScriptActive then return end
        local twOut = TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {Position = UDim2.new(0, 250, 0, 0), Size = UDim2.new(0.8, 0, 0, 32)})
        table.insert(activeTweens, twOut)
        twOut:Play()
        twOut.Completed:Connect(function() pcall(function() notif:Destroy() end) end)
    end)
end

