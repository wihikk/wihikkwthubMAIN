local function ToggleMenu(forceState)
    if forceState ~= nil then guiVisible = forceState else guiVisible = not guiVisible end
    if guiVisible then
        Frame.Visible = true
        DevToolsBtn.Visible = true
        
        local twHub = TweenService:Create(HubBtn, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundTransparency = 1, TextTransparency = 1})
        TweenService:Create(HubStroke, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Transparency = 1}):Play()
        twHub:Play()
        twHub.Completed:Connect(function(state) if state == Enum.PlaybackState.Completed and guiVisible then HubBtn.Visible = false end end)

        TweenService:Create(DevToolsBtn, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundTransparency = 0, TextTransparency = 0}):Play()
        TweenService:Create(DTStroke, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Transparency = 0}):Play()

        local tw = TweenService:Create(Frame, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(0, 520, 0, 600)})
        table.insert(activeTweens, tw)
        tw:Play()
    else
        HubBtn.Visible = true
        TweenService:Create(HubBtn, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundTransparency = 0.15, TextTransparency = 0}):Play()
        TweenService:Create(HubStroke, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Transparency = 0}):Play()

        TweenService:Create(DevToolsBtn, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {BackgroundTransparency = 1, TextTransparency = 1}):Play()
        TweenService:Create(DTStroke, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Transparency = 1}):Play()
        
        local tw = TweenService:Create(Frame, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Size = UDim2.new(0, 520, 0, 0)})
        table.insert(activeTweens, tw)
        tw:Play()
        tw.Completed:Connect(function(state) 
            if state == Enum.PlaybackState.Completed and not guiVisible then 
                Frame.Visible = false 
                DevToolsBtn.Visible = false
            end 
        end)
    end
end

HubBtn.MouseButton1Click:Connect(function()
    ToggleMenu(true)
end)

