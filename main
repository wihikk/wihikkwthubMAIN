        local val = math.floor((rawPos * 10) * 10) / 10
        settings.hitSoundVolume = val
        VolValue.Text = tostring(val)
        TweenService:Create(VolFill, TweenInfo.new(0.1), {Size = UDim2.new(rawPos, 0, 1, 0)}):Play()
