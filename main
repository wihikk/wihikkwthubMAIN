local tabs = {}
local activePage = nil
local tabCount = 0

local function createPage(name)
    local Page = Instance.new("Frame", Frame)
    Page.Name = name
    Page.Size = UDim2.new(1, 0, 1, -185)
    Page.Position = UDim2.new(0, 0, 0, 85)
