        if forceClose == true and not _G.wsState then return end
        if forceClose == true then
            _G.wsState = false
        else
            _G.wsState = not _G.wsState
        end
        WSBtn.Text = _G.wsState and "Weapon Stealer <" or "Weapon Stealer >"
